    local function rndStr()
        local c = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
        local s = ""
        for i = 1, math.random(16, 24) do s = s .. string.sub(c, math.random(1, #c), math.random(1, #c)) end
        return s
    end

