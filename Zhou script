-- Trial duration set to 1 day (86400 seconds)
local trialDuration = 86400 
local startTime = tick()

local function checkTrial()
    if tick() - startTime > trialDuration then
        pcall(function()
            LP:Kick("Trial period expired (24 Hours). Please complete the requirements to renew the script!")
        end)
        return false
    end
    return true
end

